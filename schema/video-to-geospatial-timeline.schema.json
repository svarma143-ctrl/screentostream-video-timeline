{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/svarma143-ctrl/screentostream-video-timeline/main/schema/video-to-geospatial-timeline.schema.json",
  "title": "Video-to-Geospatial Timeline",
  "description": "A vendor-neutral JSON document that maps time ranges in a video to places, scenes, evidence, and optional bookable offers.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "media", "timeline"],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "schema_version": {
      "const": "0.1.0"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "media": {
      "$ref": "#/$defs/media"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "generator": {
      "$ref": "#/$defs/generator"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "integrations": {
      "$ref": "#/$defs/integrations"
    },
    "timeline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/timelineEntry"
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true,
      "description": "Vendor-specific data that does not belong in the portable core."
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$",
      "description": "Stable identifier. Use a namespaced form such as scene_kyoto_pontocho."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Calibrated confidence from 0 to 1. Do not use this as a substitute for evidence."
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "duration_seconds"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "episode": {
          "type": "string",
          "minLength": 1
        },
        "duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "language": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "Where the media is from, such as a catalog id, CMS, or capture device."
        },
        "external_ids": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "description": "How the timeline was produced, such as deterministic-scene-match or multimodal-llm."
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "method": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "integrations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mcp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["server"],
          "properties": {
            "server": {
              "type": "string",
              "format": "uri",
              "description": "The MCP endpoint that can resolve viewing context or execute a booking."
            },
            "tools": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          }
        },
        "booking": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "tool": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "timelineEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "start_seconds", "end_seconds", "scene", "place", "confidence"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "start_seconds": {
          "type": "number",
          "minimum": 0
        },
        "end_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "start_timecode": {
          "type": "string",
          "pattern": "^\\d{2,}:\\d{2}:\\d{2}(?:\\.\\d{1,3})?$"
        },
        "end_timecode": {
          "type": "string",
          "pattern": "^\\d{2,}:\\d{2}:\\d{2}(?:\\.\\d{1,3})?$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "scene": {
          "$ref": "#/$defs/scene"
        },
        "place": {
          "$ref": "#/$defs/place"
        },
        "bookable": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bookable"
          },
          "uniqueItems": true
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "subjects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "visual": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "emoji": {
              "type": "string",
              "minLength": 1
            },
            "palette": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "minItems": 1,
              "maxItems": 6
            },
            "mood": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "dialogue": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "place": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "destination_id": {
          "type": "string",
          "minLength": 1
        },
        "city": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "country": {
          "type": "string",
          "minLength": 1
        },
        "country_code": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "coordinates": {
          "$ref": "#/$defs/coordinates"
        },
        "accuracy_meters": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "coordinates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latitude", "longitude"],
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "bookable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "catalog_ref"],
      "properties": {
        "kind": {
          "enum": ["stay", "experience", "dining", "activity", "product", "other"]
        },
        "catalog_ref": {
          "type": "string",
          "minLength": 1,
          "description": "A stable id in the provider's catalog, not a price or a transient URL."
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "price": {
          "type": "object",
          "additionalProperties": false,
          "required": ["amount", "currency"],
          "properties": {
            "amount": {
              "type": "number",
              "minimum": 0
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "unit": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "availability": {
          "type": "string",
          "minLength": 1,
          "description": "A human-readable availability hint. Do not treat it as a live inventory guarantee."
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": ["caption", "transcript", "frame", "ocr", "manual", "model", "other"]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "anyOf": [
        {
          "required": ["text"]
        },
        {
          "required": ["uri"]
        }
      ]
    }
  }
}
